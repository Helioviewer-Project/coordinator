# nginx-proxy + acme-companion (Let's Encrypt) settings — PRODUCTION defaults.
# Copy this file to .env and fill in your real production values:
#
#   cp .env.production .env
#
# or point compose at it directly:
#
#   docker compose -f docker/docker-compose.yml --env-file .env.production up
#
# .env is gitignored — your real domain/email never get committed.

# FastAPI runtime environment. "production" builds a lean image WITHOUT the dev
# tools (black, pytest, coverage); use "development" to include them.
FASTAPI_ENV=production

# Public hostname this coordinator instance is served at.
VIRTUAL_HOST=coordinator.helioviewer.org

# Port the app listens on inside the container (FastAPI runs on 80).
VIRTUAL_PORT=80

# Hostname to request a Let's Encrypt certificate for (usually == VIRTUAL_HOST).
LETSENCRYPT_HOST=coordinator.helioviewer.org

# Contact email Let's Encrypt uses for expiry / recovery notices.
LETSENCRYPT_EMAIL=you@example.com
